---
/* ============================================================
   Öne çıkanlar / haftanın tercihleri şeridi (§7).

   Kart neredeyse tamamen GÖRSEL: 4:5 dikey kırpım, altında küçük
   kapital ad. Çıplak metin kartları bu bölümün amacını kaçırıyordu —
   burada iş görselin.

   FİYAT YOK. Gerekçe hero kartındakiyle aynı: burası bir vitrin,
   fiyat listesi değil. Fiyat menü listesinde ve büyük görünümde
   yaşıyor; karta dokunulunca zaten görünüyor.

   BAŞLIK kendi stilini üretmiyor: menüdeki ana kategori başlığının
   ta kendisi (.cat-head). Eskiden sol dikey çubuk + yatay kural
   taşıyordu — hero kartından kaldırdığımız donanımın aynısı — ve o
   yüzden sayfanın --pad hizasından sağa kaymıştı. Artık sayfada tek
   bir başlık dili var: bant + sol altın kenar.

   Kart bir <button>: dokunmak büyük görünümü açar (§8). Şerit bir
   gezinme aracı değil bir vitrin — kategori gezinmesini ray yapıyor.

   SARMA DİKİŞSİZ: liste iki kez basılıyor, ikinci kopya
   aria-hidden + tabindex=-1. Akış motoru scripts/app.ts'te
   (masaüstünde CSS animasyonu, dokunmatikte rAF + scrollLeft).

   Kaynak: menu.json → venues[].featured. Şerit küratörlü ve
   fotoğraf ağırlıklı, bu yüzden GRUP KAPISINI ATLAR (hasPhoto):
   tipografik bir gruptan gelen tek fotoğraflı ürün (ice-americano)
   burada görselini gösterebilir. Slug bulunamazsa sessizce atlanır.
   ============================================================ */
import Shot from './Shot.astro';
import { itemBySlug } from '../data/menu';
import { hasPhoto } from '../lib/config';

interface Props {
  slugs: string[];
}

const { slugs } = Astro.props;

const cards = slugs
  .map((s) => {
    const item = itemBySlug(s);
    return item ? { item, photo: hasPhoto(item.slug) } : null;
  })
  .filter((x): x is NonNullable<typeof x> => x !== null);

/* İkinci tur yalnız sarma dikişi için. Ekran okuyucu ve klavye için
   yok hükmünde; reduced-motion altında CSS onu tamamen gizliyor. */
const passes = [false, true] as const;
---

{cards.length > 0 && (
  <section class="reco" aria-labelledby="recoTitle">
    <div class="cat-head">
      <h2 id="recoTitle">Leo'nun Önerdikleri</h2>
      <span class="rule" aria-hidden="true"></span>
    </div>

    <div class="reco-view">
      <div class="reco-track" id="recoTrack">
        {passes.map((dup) =>
          cards.map(({ item, photo }, i) => {
            /* görselsiz kart tıklanabilir olmamalı: açılacak bir şey yok */
            const Tag = photo ? 'button' : 'div';
            const extra = photo ? { type: 'button' as const, 'data-lb': item.slug } : {};
            return (
              <Tag
                class:list={['reco-card', dup && 'reco-dup', !photo && 'no-shot']}
                aria-hidden={dup ? 'true' : undefined}
                tabindex={dup && photo ? -1 : undefined}
                {...extra}
              >
                {photo && (
                  <Shot slug={item.slug} name={item.name} decorative eager={!dup && i < 2} />
                )}
                <span class="rn">{item.name}</span>
              </Tag>
            );
          }),
        )}
      </div>
    </div>
  </section>
)}
