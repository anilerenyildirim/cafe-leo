---
/* ============================================================
   Kategori rayı — sticky, bar'ın hemen altında (top: var(--bar-h),
   yüksekliği çalışma anında ölçülüyor).

   D1 KARARI: rayda YALNIZ BEŞ ANA KATEGORİ var. Alt kategoriler için
   ikinci bir yapışkan şerit EKLENMEDİ — iki yapışkan şerit telefonda
   ~100px dikey alan yer, 667px'lik bir ekranda içeriğin %15'i.
   Üstelik kaydırdıkça içeriği değişen ikinci bir şerit yerleşim
   kayması ve kafa karışıklığı üretirdi; düzeltmeye çalıştığımız şey
   tam olarak buydu. Alt kategorilere erişim bölüm başlığının hemen
   altındaki YAPIŞKAN OLMAYAN çip satırından (Section.astro).

   D2: çip puntosu 1px büyütüldü, aktif kategori artık alt çizgiyle
   değil dolgulu altın kapsülle belirtiliyor, şeridin kaydırılabilir
   olduğu iki kenardaki maskeyle söyleniyor (maske yalnız gerçekten
   kaydırılabilirken açılıyor — scripts/app.ts § railEdges).

   OKLAR: maske tek başına "burada devam var" demeye yetmiyordu —
   müşteri şeridi kaydırılabilir görmedi. İki uca birer ok kondu.
   İlk deneme fazla soluktu (%40, ince çizgi) ve maskenin solmasına
   karışıyordu; ağırlığı artırıldı. Ok maskeyle AYNI anahtarı
   kullanıyor (edge-l / edge-r):
   gidilecek yer yoksa ok da yok, yani ok hiçbir zaman yalan
   söylemiyor. Süsleme değil işaret olduğu için aria-hidden ve
   pointer-events:none — klavye sırasına girmiyor, altındaki çipin
   dokunuşunu yemiyor.

   Scroll spy scripts/app.ts'te: kaydırdıkça aktif kategori
   aria-current="true" alıyor ve çip görünüme kayıyor.

   Kaydırma kutusu ayrı bir katman (.rail-scroll): maske ve gölge
   kaymayan .rail'e bağlı, içerikle birlikte sürüklenmiyor.
   ============================================================ */
import type { Section } from '../data/menu';

interface Props {
  sections: Section[];
}

const { sections } = Astro.props;
---

<nav class="rail" aria-label="Kategoriler">
  <span class="rail-arw l" aria-hidden="true"></span>
  <div class="rail-scroll" id="rail">
    <ul>
      {sections.map((s) => (
        <li><a href={`#${s.slug}`}>{s.title}</a></li>
      ))}
    </ul>
  </div>
  <span class="rail-arw r" aria-hidden="true"></span>
</nav>
