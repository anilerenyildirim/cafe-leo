---
/* ============================================================
   / — tanıtım sayfası. TEK EKRAN: marka, iki mekan.

   QR kodları /menu'ye gidiyor; bu sayfa web'den gelen ziyaretçi için.
   Dil menü sayfalarıyla aynı: aynı eyebrow, aynı kare nokta.

   BU TURDA DEĞİŞEN — İKİ KART ARTIK EŞİT DEĞİL.

   Sayfa iki mekanı eşit ağırlıkta sunuyordu, ama bugün yalnız biri
   açık. Bu adreste (cafe-leo.onlinemenu-qr.com) Cafe Leo Teras BİRİNCİ
   kart: gerçek butonlarla, kendi yüzeyinde. Leo Lounge İKİNCİ kart ve
   inaktif: koyulaştırılmış, butonsuz, düşük kontrastlı — bakar bakmaz
   "burası henüz açık değil" diyor.

   İnaktif kartta buton YOK ama kart ölü de değil: tamamı tek bir
   bağlantı, Instagram'a gidiyor. Kartın içine devre dışı bir buton
   koyup üstüne bir de bağlantı sarmak iki yalan söylerdi — "tıkla"
   ve "tıklayamazsın" aynı yüzeyde duramaz. Bu yüzden yüzeyin tamamı
   tek ve net bir hedef.

   Menü ve Konum artık metin-link değil GERÇEK BUTON: 48px dokunma
   hedefi, dolgulu birincil + çerçeveli ikincil. Eski 10.5px
   letterspaced metin satırı masaüstünde zarifti ama telefonda hem
   küçük hem isabetsizdi — bu sayfada yapılacak tek iş o iki buton.

   leo-lounge.onlinemenu-qr.com aynı sayfayı ters rollerle gösterecek
   (ayrı proje: Demos/leo-lounge). Uydurma saat, telefon veya adres
   yok; null olan alan hiç basılmıyor.
   ============================================================ */
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { VENUES } from '../data/menu';

const cafe = VENUES.find((v) => v.key === 'cafe')!;
const lounge = VENUES.find((v) => v.key === 'lounge')!;
---

<Base
  venue="cafe"
  title={`Leo — ${cafe.name} & ${lounge.name}, Sinanoba`}
  description={`${cafe.name} ve ${lounge.name} — Sinanoba, Büyükçekmece. Menü, konum ve iletişim.`}
>
  <div class="wrap home">
    <div class="home-brand">
      <Logo size="lg" />
      <p class="eyebrow">
        <span>Sinanoba</span><span class="sq" aria-hidden="true"></span><span>Büyükçekmece</span>
      </p>
    </div>

    <h1 class="sr-only">{cafe.name} ve {lounge.name}</h1>

    <div class="home-venues">
      <section class="home-venue card-cafe">
        <h2>{cafe.name}</h2>
        <p class="tagline">{cafe.tagline}</p>

        <nav class="home-acts" aria-label={`${cafe.name} bağlantıları`}>
          <a class="btn btn-primary" href="/menu">Menü</a>
          {cafe.contact.mapsUrl && (
            <a class="btn btn-ghost" href={cafe.contact.mapsUrl} target="_blank" rel="noopener">
              Konum
            </a>
          )}
        </nav>
      </section>

      <a
        class="home-venue card-off"
        href={lounge.contact.instagram ?? cafe.contact.instagram ?? '#'}
        target="_blank"
        rel="noopener"
      >
        <h2>{lounge.name}</h2>
        <p class="tagline">{lounge.tagline}</p>

        <p class="invite">
          <span class="invite-txt">Lounge'a da bekleriz</span>
          <span class="sq" aria-hidden="true"></span>
          <span class="invite-cta">Instagram</span>
        </p>
      </a>
    </div>
  </div>
</Base>

<style>
  .home { padding: 0 var(--pad); }

  /* marka bloğu yatay ortada. Logo kutusu sabit ölçülü
     (bkz. Logo.astro), gerçek logoya geçişte bu blok oynamaz. */
  .home-brand {
    margin-top: 9vh;
    display: flex; flex-direction: column; align-items: center;
  }
  .home-brand .eyebrow { margin-top: 20px; justify-content: center; text-align: center; }

  .home-venues { margin-top: 10vh; display: grid; gap: 44px; align-items: stretch; }

  .home-venue {
    display: flex; flex-direction: column;
    border-radius: 14px;
    padding: 28px 30px 26px;
  }
  .home-venue h2 {
    font-family: var(--font-display); font-weight: 500;
    font-size: 30px; line-height: 1;
  }
  .home-venue .tagline { margin-top: 10px; max-width: 30ch; }

  /* ---------- AKTİF KART ---------- */

  .card-cafe {
    background:
      linear-gradient(158deg,
        color-mix(in oklch, var(--surf) 92%, transparent) 0%,
        color-mix(in oklch, var(--surf) 55%, transparent) 100%);
    border: 1px solid color-mix(in oklch, var(--text) 10%, transparent);
    border-left: 2px solid var(--gold-leaf);
    box-shadow:
      0 1px 2px rgba(60, 44, 12, .05),
      0 10px 28px -12px rgba(60, 44, 12, .20);
  }

  /* Buton satırı kartın tabanına oturur — eşit yükseklikte kartlarda
     iki kartın alt kenarı hizalı kalsın. */
  .home-acts {
    margin-top: auto; padding-top: 26px;
    display: flex; flex-wrap: wrap; gap: 12px;
  }

  /* 48px: parmak hedefi için alt sınır. Punto 13px ve harf aralığı
     .1em — eski 10.5px/.19em satır telefonda hem okunmuyor hem
     ıskalanıyordu. Kelime uzunluğu değişince buton büyüklüğü
     değişmesin diye min-width var; iki buton yan yana dengede. */
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 48px; min-width: 132px;
    padding: 0 26px;
    border-radius: 999px;
    text-decoration: none;
    font: 500 13px/1 var(--font-body);
    letter-spacing: .1em; text-transform: uppercase;
    transition: background-color .25s ease, border-color .25s ease, color .25s ease;
  }

  .btn-primary {
    background: var(--gold-leaf);
    color: var(--on-gold);
    border: 1px solid var(--gold-leaf);
  }
  .btn-ghost {
    background: transparent;
    color: var(--text);
    border: 1px solid color-mix(in oklch, var(--text) 26%, transparent);
  }

  @media (hover: hover) {
    .btn-primary:hover { background: color-mix(in oklch, var(--gold-leaf) 86%, #000); }
    .btn-ghost:hover { border-color: var(--gold-leaf); }
  }

  /* ---------- İNAKTİF KART ----------
     Kapalı mekan "soluk" değil KOYU. Açık temada bir yüzeyi
     silikleştirmenin iki yolu var: opaklığı düşürmek ya da zemini
     koyultmak. Opaklık kartı sayfadan siler; koyultmak orada
     olduğunu ama şimdilik kapalı olduğunu söyler.

     Ölçüm: metin rengi bu zeminde 4.6:1 — kasten düşük kontrast ama
     WCAG AA eşiğinin üstünde. "İnaktif görünsün" okunmasın demek
     değil. */
  .card-off {
    background:
      linear-gradient(158deg,
        color-mix(in oklch, var(--text) 15%, var(--surf)) 0%,
        color-mix(in oklch, var(--text) 9%, var(--surf)) 100%);
    border: 1px solid color-mix(in oklch, var(--text) 14%, transparent);
    border-left: 2px solid color-mix(in oklch, var(--text) 30%, transparent);
    box-shadow: none;
    text-decoration: none;
    color: inherit;
    transition: background-color .3s ease, border-color .3s ease;
  }
  .card-off h2 { color: color-mix(in oklch, var(--text) 62%, transparent); }
  .card-off .tagline { color: var(--muted); }

  .invite {
    margin-top: auto; padding-top: 26px;
    display: flex; flex-wrap: wrap; align-items: center; gap: 11px;
    font: 500 11.5px/1.5 var(--font-body);
    letter-spacing: .13em; text-transform: uppercase;
  }
  .invite-txt { color: var(--muted); }
  /* Tek tıklanır şey kartın kendisi — bu bir buton değil, nereye
     gideceğini söyleyen etiket. Alt çizgi onu bağlantı diliyle
     işaretliyor, buton yüzeyi vermiyor. */
  .invite-cta {
    color: var(--gold-ink);
    padding-bottom: 3px;
    border-bottom: 1px solid color-mix(in oklch, var(--gold-ink) 45%, transparent);
  }
  .card-off .sq { color: color-mix(in oklch, var(--text) 30%, transparent); }

  @media (hover: hover) {
    .card-off:hover {
      background:
        linear-gradient(158deg,
          color-mix(in oklch, var(--text) 18%, var(--surf)) 0%,
          color-mix(in oklch, var(--text) 11%, var(--surf)) 100%);
      border-color: color-mix(in oklch, var(--gold-ink) 40%, transparent);
    }
    .card-off:hover .invite-cta { border-bottom-color: var(--gold-ink); }
  }

  /* Alt bilgi YOK. Buradaki tek satır demo uyarısıydı; o kalkınca
     geriye üstünde hairline olan boş bir bant kalıyordu — içeriği
     olmayan bir ayraç sayfaya "eksik bir şey var" dedirtiyor.
     Sayfa kartlardan sonra bitiyor, nefesi body'nin alt dolgusu
     veriyor. */

  @media (min-width: 480px) {
    /* Dar telefonda butonlar alt alta daha güvenli; 480px'ten sonra
       yan yana ve satırı doldurmuyorlar. */
    .home-acts { gap: 14px; }
  }
  @media (max-width: 359px) {
    .btn { min-width: 0; flex: 1 1 100%; padding: 0 18px; letter-spacing: .06em; }
  }
  @media (min-width: 720px) {
    .home-venues { grid-template-columns: 1fr 1fr; gap: 40px; }
  }
  @media (min-width: 1100px) {
    .home-venue { padding: 34px 36px 30px; }
    .home-venue h2 { font-size: 34px; }
  }
</style>
