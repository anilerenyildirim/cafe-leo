---
/* ============================================================
   Alt bilgi.

   "Demo — fiyatlar ve ürün listesi teyit bekliyor." notu KALDIRILDI:
   site canlıya çıkıyor, fiyatlar müşteriden teyitli geldi. Ziyaretçiye
   menünün güvenilmez olduğunu söyleyen bir satır artık yalan olurdu.

   null contact alanları basılmaz — uydurma yok, yer tutucu yok.
   ============================================================ */
import Logo from './Logo.astro';
import type { Venue } from '../data/menu';

interface Props {
  venue: Venue;
}

const { venue } = Astro.props;
const c = venue.contact;
---

<footer>
  {/* Alttaki imza da logonun kendisi: gerçek varlık geldiğinde
      Logo.astro'yu değiştirmek üç görünümü birden çevirir. */}
  <Logo size="sm" class="sig" />
  <p>
    {c.address && <>{c.address}<br /></>}
    {venue.hoursText && <>{venue.hoursText}<br /></>}
  </p>
</footer>
