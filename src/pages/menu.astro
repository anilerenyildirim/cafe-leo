---
/* ============================================================
   /menu — Cafe Leo Teras menüsü. Masa QR'ları buraya gelir.
   Ana sayfadan menüye ekstra dokunuş yok; bu sayfa kendi başına ayakta.

   Bölüm sırası menu.json'daki dizi sırasıdır — ayrı bir `order`
   alanı yok, sıra verinin kendisinde duruyor.
   ============================================================ */
import Base from '../layouts/Base.astro';
import Bar from '../components/Bar.astro';
import Masthead from '../components/Masthead.astro';
import Hero from '../components/Hero.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Featured from '../components/Featured.astro';
import Rail from '../components/Rail.astro';
import Section from '../components/Section.astro';
import Foot from '../components/Foot.astro';
import { VENUES, itemBySlug } from '../data/menu';

const venue = VENUES.find((v) => v.key === 'cafe')!;
const sections = venue.sections ?? [];
const hero = venue.hero ? itemBySlug(venue.hero) : undefined;
---

<Base
  venue="cafe"
  title={`${venue.name} — Menü`}
  description={`${venue.name}, Sinanoba Büyükçekmece. Kahve, tatlı, mutfak — güncel menü.`}
>
  <Bar venue="cafe" />

  <h1 class="sr-only">{venue.name} menüsü</h1>

  <div class="wrap">
    <Masthead name={venue.name} />

    <div class="stage">
      {/* eyebrow yok: masthead zaten mekan adını söylüyor, hemen
          altındaki "Kafe & Teras · Sinanoba" tekrardı. */}
      <Hero venue={venue} eyebrow={false} />
      {hero && <FeatureCard item={hero} />}
    </div>

    <Featured slugs={venue.featured} />

    <Rail sections={sections} />

    <main id="menu">
      {sections.map((s) => <Section sec={s} />)}
    </main>

    <Foot venue={venue} />
  </div>
</Base>
