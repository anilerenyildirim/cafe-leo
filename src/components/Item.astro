---
/* ============================================================
   Ürün satırı.

   Görsel kararı ÜRÜN bazında: kategori fotoğraf düzeninde olsa bile
   dosyası olmayan ürün `.no-shot` alıp tipografik satır olarak gelir.
   Sonradan çöken bir düzen değil — doğuştan öyle basılıyor.

   leoPick rozeti kartın sağ üstünde. Fiyatın solundaki kare nokta
   .price::before'da: ad iki satıra sardığında ayrı bir flex çocuğu
   satırın ortasına kayıyordu.

   `data-slug` büyük görünümün (§8) tek veri kaynağı: ad, fiyat,
   açıklama ve rozet zaten burada duruyor, ikinci bir JSON basılmıyor.
   ============================================================ */
import Shot from './Shot.astro';
import { itemHasPhoto } from '../lib/config';
import type { CategoryId, MenuItem } from '../data/menu';

interface Props {
  item: MenuItem;
  catId: CategoryId;
  hidePrice?: boolean;
}

const { item, catId, hidePrice = false } = Astro.props;
const photo = itemHasPhoto(item.slug, catId);
---

<div class:list={['item', !photo && 'no-shot']} data-slug={item.slug}>
  {photo && <Shot slug={item.slug} name={item.name} trigger />}
  <div class="meta">
    {item.leoPick && <span class="pick-badge">Leo'nun tercihi</span>}
    <div class="row">
      <span class="name">{item.name}</span>
      {item.tag && <span class="tag">{item.tag}</span>}
      {!hidePrice && (
        <>
          <span class="gap" aria-hidden="true"></span>
          <span class="price">{item.price} ₺</span>
        </>
      )}
    </div>
    {item.desc && <p class="desc">{item.desc}</p>}
  </div>
</div>
