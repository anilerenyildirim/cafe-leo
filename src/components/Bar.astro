---
/* ============================================================
   Üst bar: marka + mekan anahtarı.

   C1 — bar artık gövdeyle AYNI DÜZLEMDE DEĞİL: zemini bir ton
   farklı, altında hairline, sayfa kaydırıldığında (`.is-stuck`,
   scripts/app.ts) hafif gölge biniyor.

   C2 — müşteri bu kontrolün fark edilmediğini söyledi, haklıydı:
   iki metin bağlantısı gibi duruyordu. İki şey değişti:
     · aktif segment dolgulu kapsül oldu (altın zemin + --on-gold),
     · PASİF segmentin üzerinden 4 saniyede bir parıltı geçiyor.
   Parıltı bilerek pasifte: aktif zaten belli, keşfedilmesi gereken
   diğerinin tıklanabilir olduğu. Parıltıya yaslanılmıyor — kapsül
   reduced-motion altında da kontrolü belirgin bırakıyor.

   /menu ve /lounge ayrı rotalar olduğu için <a> + aria-current="page"
   (aria-pressed bir link üzerinde geçersiz olurdu).
   ============================================================ */
import Logo from './Logo.astro';
import { VENUES } from '../data/menu';

interface Props {
  venue: 'cafe' | 'lounge';
  /**
   * Mekan anahtarı basılsın mı?
   *
   * Kart ızgaralı menüde KAPALI (müşteri isteği). Orada barın tek işi
   * markayı taşımak; kategori gezinmesini ızgaranın kendisi yapıyor
   * ve Lounge'ın henüz menüsü yok — iki kapsül ekranın en üstünde
   * cevabı olmayan bir soru soruyordu.
   *
   * Varsayılan AÇIK: canlı /menu ve /lounge bu propu hiç geçmiyor,
   * davranışları değişmiyor.
   */
  switcher?: boolean;
}

const { venue, switcher = true } = Astro.props;
const href: Record<'cafe' | 'lounge', string> = { cafe: '/menu', lounge: '/lounge' };
const label: Record<'cafe' | 'lounge', string> = { cafe: 'Cafe', lounge: 'Lounge' };
---

<header class="bar">
  <div class="bar-in">
    <a class="mark" href="/" aria-label="Leo — ana sayfa">
      <Logo size="sm" />
    </a>

    {switcher && (
      <nav class="seg" aria-label="Mekan seç">
        {/* Kare nokta ayracı kalktı: iki kapsül arasında ayıracak bir
            şey yok, nokta yalnız gürültü olurdu. */}
        {VENUES.map((v) => (
          <a href={href[v.key]} aria-current={v.key === venue ? 'page' : undefined}>
            <span class="seg-t">{label[v.key]}</span>
          </a>
        ))}
      </nav>
    )}
  </div>
</header>
