---
/* ============================================================
   Kategori kartı — POLAROİD.

   Kart bir <a>: kategori sayfasına götürüyor. Öneri şeridindeki
   kartlar gibi büyük görünüm açmıyor — burada iş gezinme.

   BİÇİM: kâğıt bir çerçeve, içinde kare bir fotoğraf, altında adı.
   Ad fotoğrafın ÜSTÜNE binmiyor — eskiden biniyordu ve okunurluğu
   fotoğrafın kendi karanlığına bağlıydı; açık kareli kategorilerde
   (kruvasan, salata, patates) yazının altına konan gradyan hem
   yetmiyor hem de fotoğrafın alt üçte birini yiyordu. Ad kâğıda
   çıkınca kontrast her kartta aynı oldu. Ölçüler menu.css →
   `.cat-card` / `.cc-name`.

   DOM SIRASI = OKUMA SIRASI: görsel, sonra ad. Eskiden ikisi
   üst üsteydi ve sıralamayı z-index yerine DOM tutuyordu; artık
   ikisi de akışta, sıra kendiliğinden doğru.

   FOTOĞRAFSIZ KART kırılmıyor, DÖNÜŞÜYOR: görsel kutusu hiç
   basılmaz, yerini kartın kendi `::before` yüzeyi alır (.no-shot)
   — çerçeve ve ölçü yerinde kalır, yalnız kutunun içi boş krem
   olur. Panelden fotoğraf yüklendiği an kart kendiliğinden
   görselleşiyor.
   ============================================================ */
import { cardPhoto, type MenuCard } from '../lib/menuCards';

interface Props {
  card: MenuCard;
  /** ilk satırlar — katlamanın üstünde, lazy beklemesin */
  eager?: boolean;
  /** ızgaradaki sırası — belirmenin basamaklanması CSS'te bundan
      hesaplanıyor (menu.css → --cc-i) */
  index?: number;
}

const { card, eager = false, index = 0 } = Astro.props;
const photo = cardPhoto(card);
---

<a
  class:list={['cat-card', !photo && 'no-shot']}
  href={`/menu/${card.key}`}
  style={`--cc-i: ${index}`}
>
  {photo && (
    <span class="cc-media">
      {/* alt BOŞ: erişilebilir adı bağlantının kendi metni taşıyor,
          ekran okuyucu kategoriyi iki kez okumasın */}
      <img
        src={photo.src}
        alt=""
        width={photo.w}
        height={photo.h}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding="async"
      />
    </span>
  )}
  <span class="cc-name">{card.title}</span>
</a>
