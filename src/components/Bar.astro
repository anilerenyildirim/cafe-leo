---
/* ============================================================
   Üst bar: marka + mekan anahtarı.

   Hap toggle, altın gradyan dolgu ve lamba kalktı. Anahtar artık iki
   metin, aralarında kare nokta, aktif olanın altında altın hairline.
   /menu ve /lounge ayrı rotalar olduğu için <a> + aria-current="page"
   (aria-pressed bir link üzerinde geçersiz olurdu).
   ============================================================ */
import { VENUES } from '../data/menu';

interface Props {
  venue: 'cafe' | 'lounge';
}

const { venue } = Astro.props;
const href: Record<'cafe' | 'lounge', string> = { cafe: '/menu', lounge: '/lounge' };
const label: Record<'cafe' | 'lounge', string> = { cafe: 'Cafe', lounge: 'Lounge' };
---

<header class="bar">
  <div class="bar-in">
    <a class="mark" href="/" aria-label="Leo — ana sayfa">
      <span class="wordmark" aria-hidden="true">leo</span>
    </a>

    <nav class="seg" aria-label="Mekan seç">
      {VENUES.map((v, i) => (
        <>
          {i > 0 && <span class="sq" aria-hidden="true"></span>}
          <a href={href[v.key]} aria-current={v.key === venue ? 'page' : undefined}>
            {label[v.key]}
          </a>
        </>
      ))}
    </nav>
  </div>
</header>
