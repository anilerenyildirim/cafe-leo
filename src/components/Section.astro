---
/* ============================================================
   Kategori bölümü — İKİ SEVİYELİ.

   D3: başlıklar artık çıplak değil, açık kahve bir zemin bandı
   üzerinde. Kaydırırken bölümlerin nerede başlayıp bittiği bandın
   kendisinden okunuyor. Ana başlığın solunda 3px altın kenar var —
   bu, kaldırılan "stem" motifinin bant içindeki karşılığı. Alt
   başlık hiyerarşiyi tonla söylüyor: daha soluk zemin, daha küçük
   tipografi, altın kenarı yok.

   D1: alt kategoriler için ikinci bir YAPIŞKAN şerit yok. Bölümün
   başlığının hemen altında yapışkan OLMAYAN bir çip satırı var —
   bölüm içinde atlama sağlıyor, kalıcı dikey alan tüketmiyor,
   kaydırırken değişmiyor. Tek gruplu bölümde (İmza Ürünler, Sıcak
   İçecekler, Tatlılar) çip satırı ve alt başlık hiç basılmıyor.

   ÇİP BELİRTECİ: alt kategori çipi küçük yuvarlak bir görsel
   taşıyabiliyor. Ayrı ikon seti çizilmedi — grubu en iyi anlatan
   ÜRÜNÜN KENDİ fotoğrafı kullanılıyor (menu.json → subsection.icon).
   Dosya yoksa çip sessizce metne düşüyor; bu yüzden henüz
   çekilmemiş fotoğrafın slug'ı bugünden yazılabiliyor.

   "Leo'nun tercihi" rozeti YALNIZCA REFERANSLARDAN OLUŞAN bölümde
   (İmza Ürünler) basılmaz: başlık zaten seçkiyi söylüyor, her satırda
   tekrarlamak gürültü ve "tercih" beş üründe birden kullanılınca
   hero'daki gerçek tercihin anlamı kalmıyor. Rozet ürünün kendi
   bölümünde duruyor — orada bilgi taşıyor.

   Düzen kararı ALT KATEGORİ bazında (lib/config.ts → NO_PHOTO):
   · fotoğraf öncelikli — grup NO_PHOTO'da değilse
   · tipografik        — görsel kutusu hiç basılmaz
   Bu yüzden aynı mokteyl "Mokteyller" altında tipografik, "İmza
   Ürünler" altında fotoğraf düzeninde durabiliyor.

   FİYAT HER SATIRDA. Bir zamanlar tek fiyatlı grup (Frozenler: hepsi
   250 ₺) fiyatı başlığın altında bir kez söylüyordu; müşteri
   isteğiyle kaldırıldı — fiyatı aynı olsa da her ürünün yanında
   kendi fiyatı yazıyor. Menüde okunacak tek yer var.

   Ekstralar ürün kartı değil: ait olduğu grubun altında tek satır
   şerit. Artık gruba da bağlanabiliyorlar — şurup ve ekstra shot
   "Soğuk Kahveler"in altında duruyor, bütün Soğuk İçecekler'in
   değil.

   `data-reveal` (§9c): belirme KATEGORİ başına bir kez tetiklenir,
   ürün başına değil.
   ============================================================ */
import Item from './Item.astro';
import { formatPrice, photoOf, type Section } from '../data/menu';
import { isPhotoGroup, hasPhoto } from '../lib/config';

interface Props {
  sec: Section;
}

const { sec } = Astro.props;

/** Başlığı olan alt gruplar — çip satırının ve alt başlığın koşulu */
const named = sec.subs.filter((s) => s.title !== null);
const showChips = named.length > 1;

const two = (n: number): string => String(n).padStart(2, '0');

/** Çip belirteci — yalnız fotoğrafı GERÇEKTEN varsa. Yoksa null → metin çip. */
const iconSrc = (icon: string | undefined): string | null =>
  (icon && hasPhoto(icon) && photoOf(icon)?.src) || null;
---

<section class="sec" id={sec.slug} aria-labelledby={`h-${sec.slug}`} data-reveal>
  <div class="cat-head">
    <h2 id={`h-${sec.slug}`}>{sec.title}</h2>
    <span class="rule" aria-hidden="true"></span>
    <span class="n" aria-hidden="true">{two(sec.count)}</span>
  </div>

  {showChips && (
    <nav class="subcats" aria-label={`${sec.title} — alt kategoriler`}>
      <div class="subcats-scroll">
        {named.map((sub) => {
          const ico = iconSrc(sub.icon);
          return (
            <a href={`#${sub.slug}`} class:list={[ico && 'has-ico']}>
              {ico && (
                <img class="chip-ico" src={ico} alt="" width="48" height="48" loading="lazy" decoding="async" />
              )}
              <span>{sub.title}</span>
            </a>
          );
        })}
      </div>
    </nav>
  )}

  {sec.subs.map((sub) => {
    const photo = isPhotoGroup(sub.slug);
    /* açıklamalı listeler geniş ekranda üç kolona çıkmaz — kolon
       daralınca açıklama satırları kırılıyor */
    const hasDesc = sub.items.some((i) => i.desc);

    return (
      <section
        class="sub"
        id={sub.title ? sub.slug : undefined}
        aria-labelledby={sub.title ? `h-${sub.slug}` : undefined}
      >
        {sub.title && (
          <div class="sub-head">
            <h3 id={`h-${sub.slug}`}>{sub.title}</h3>
            <span class="gap" aria-hidden="true"></span>
            <span class="n" aria-hidden="true">{two(sub.items.length)}</span>
          </div>
        )}

        <div class:list={['items', photo ? 'photo' : 'type', hasDesc && 'has-desc']}>
          {sub.items.map((item) => (
            <Item item={item} group={sub.slug} hidePrice={false} showPick={!sec.refsOnly} />
          ))}
        </div>

        {sub.extras.length > 0 && (
          <p class="extras">
            <span class="lbl">Ekstra</span>
            {/* Astro ifade ile eleman arasındaki boşluğu yutuyor — ad ile
                fiyat arasındaki ayrım &#32; ile açıkça basılıyor. */}
            {sub.extras.map((e, i) => (
              <>
                {i > 0 && <span class="sq" aria-hidden="true"></span>}
                <span class="ex">{e.name}&#32;<b>{formatPrice(e.price)}</b></span>
              </>
            ))}
          </p>
        )}
      </section>
    );
  })}

  {sec.extras.length > 0 && (
    <p class="extras">
      <span class="lbl">Ekstra</span>
      {sec.extras.map((e, i) => (
        <>
          {i > 0 && <span class="sq" aria-hidden="true"></span>}
          <span class="ex">{e.name}&#32;<b>{formatPrice(e.price)}</b></span>
        </>
      ))}
    </p>
  )}
</section>
