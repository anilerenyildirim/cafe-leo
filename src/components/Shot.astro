---
/* ============================================================
   Fotoğraf kutusu.

   Yalnız dosyası GERÇEKTEN var olan ürünler için basılır (build
   zamanı manifestosu, lib/photos.ts). Eksik dosya için <img> hiç
   üretilmez — 404 yok, konsol temiz, düzen sıçraması yok.

   Kaynakların çoğu 1200×800 (3:2) ve liste kutusu da 3:2 — kare
   kırpımda tabak kenarları kesiliyordu, orada hiç kırpma yok.

   Mokteyller 1200×1200 (1:1): dikey çekilmiş kokteyller 3:2'ye
   sığmıyordu. Kutu oranı `shot-sq` sınıfıyla ürün bazında veriliyor
   (lib/config.ts → SQUARE_PHOTO), bölüm bazında değil: aynı ürün
   İmza Ürünler'de de görünüyor ve oranın onunla birlikte gitmesi
   gerekiyor.

   Şeritte kutu 4:5'e dönüyor (CSS), orada kırpım kasıtlı.

   `trigger`: kutu <button> olur, tıklanınca büyük görünüm açılır
   (§8). O durumda img alt'ı BOŞ ve erişilebilir ad düğmede: aksi
   halde ekran okuyucu ürün adını iki kez okurdu.

   `eager`: hero kartı ve şeridin ilk karesi için. Gerisi lazy.
   ============================================================ */
import { photoOf } from '../data/menu';

interface Props {
  slug: string;
  name: string;
  eager?: boolean;
  /** kutuyu tıklanabilir düğmeye çevir (§8) */
  trigger?: boolean;
  /** şerit kartında görsel dekoratif: erişilebilir ad kartın kendisinde */
  decorative?: boolean;
  class?: string;
}

const {
  slug, name, eager = false, trigger = false, decorative = false, class: cls = '',
} = Astro.props;

/* Ölçü ve adres artık menu.json'dan geliyor. Genişlik/yükseklik sabit
   1200×800 yazılıydı; gerçek dosyalar hepsi tam o oran değil (ör. 1200×801),
   yani tarayıcıya biraz yanlış oran bildiriliyordu. Artık dosyanın kendi
   ölçüsü basılıyor — düzen sıçraması payı da doğru hesaplanıyor. */
const photo = photoOf(slug);
const square = photo !== null && photo.w === photo.h;

const Tag = trigger ? 'button' : 'div';
const extra = trigger
  ? { type: 'button' as const, 'data-lb': slug, 'aria-label': `${name} — görseli büyüt` }
  : {};
---

<Tag class:list={['shot', square && 'shot-sq', cls]} {...extra}>
  <img
    src={photo?.src}
    alt={trigger || decorative ? '' : name}
    width={photo?.w ?? 1200}
    height={photo?.h ?? 800}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
  />
</Tag>
