---
/* ============================================================
   Ürün satırı.

   Görsel kararı ÜRÜN bazında: grup fotoğraf düzeninde olsa bile
   dosyası olmayan ürün `.no-shot` alıp tipografik satır olarak gelir.
   Sonradan çöken bir düzen değil — doğuştan öyle basılıyor. (İmza
   Ürünler'de Pink Dream şu an bu durumda: fotoğrafı gelince
   panelden fotoğrafı yüklemek yetiyor, koda dokunulmuyor.)

   leoPick rozeti kartın sağ üstünde. Fiyatın solundaki kare nokta
   .price::before'da: ad iki satıra sardığında ayrı bir flex çocuğu
   satırın ortasına kayıyordu.

   `data-slug` büyük görünümün (§8) tek veri kaynağı: ad, fiyat,
   açıklama ve rozet zaten burada duruyor, ikinci bir JSON basılmıyor.
   Aynı ürün iki grupta görünebildiği için (İmza Ürünler referansları)
   büyük görünüm satırı SLUG + BÖLÜM ile buluyor.
   ============================================================ */
import Shot from './Shot.astro';
import { itemHasPhoto } from '../lib/config';
import { formatPrice, type MenuItem } from '../data/menu';

interface Props {
  item: MenuItem;
  /** alt kategori slug'ı — fotoğraf düzeni kararının anahtarı */
  group: string;
  hidePrice?: boolean;
  /** Seçki bölümlerinde (İmza Ürünler) rozet basılmaz — bkz. Section.astro */
  showPick?: boolean;
}

const { item, group, hidePrice = false, showPick = true } = Astro.props;
const photo = itemHasPhoto(item.slug, group);
---

<div class:list={['item', !photo && 'no-shot']} data-slug={item.slug}>
  {photo && <Shot slug={item.slug} name={item.name} trigger />}
  <div class="meta">
    {showPick && item.leoPick && <span class="pick-badge">Leo'nun tercihi</span>}
    <div class="row">
      <span class="name">{item.name}</span>
      {!hidePrice && (
        <>
          <span class="gap" aria-hidden="true"></span>
          <span class="price">{formatPrice(item.price)}</span>
        </>
      )}
    </div>
    {item.desc && <p class="desc">{item.desc}</p>}
  </div>
</div>
